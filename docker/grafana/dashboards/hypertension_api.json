{
 "uid": "hypertension-api",
 "title": "Hypertension API: RED e drift",
 "tags": [
  "hypertension",
  "mlops"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "editable": false,
 "refresh": "15s",
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "templating": {
  "list": []
 },
 "annotations": {
  "list": []
 },
 "panels": [
  {
   "id": 1,
   "title": "p95 de latência /predict (janela 5 min)",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum(rate(api_request_latency_seconds_bucket{endpoint=\"/predict\"}[5m])) by (le)) * 1000",
     "legendFormat": "p95"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "ms",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 200
       },
       {
        "color": "red",
        "value": 300
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "area"
   }
  },
  {
   "id": 2,
   "title": "Requisições por segundo",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 6,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "A",
     "expr": "sum(rate(api_requests_total{endpoint=~\"/predict.*\"}[5m]))",
     "legendFormat": "rps"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "area"
   }
  },
  {
   "id": 3,
   "title": "Taxa de erro 5xx",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "A",
     "expr": "sum(rate(api_requests_total{status=~\"5..\"}[5m])) / clamp_min(sum(rate(api_requests_total[5m])), 1e-9)",
     "legendFormat": "erro"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 0.05
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value"
   }
  },
  {
   "id": 4,
   "title": "Variáveis em alerta de drift",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 18,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "A",
     "expr": "data_drift_alerts",
     "legendFormat": "alertas"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value"
   }
  },
  {
   "id": 5,
   "title": "Latência /predict: p50, p95, p99",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "A",
     "expr": "histogram_quantile(0.50, sum(rate(api_request_latency_seconds_bucket{endpoint=\"/predict\"}[5m])) by (le)) * 1000",
     "legendFormat": "p50"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "B",
     "expr": "histogram_quantile(0.95, sum(rate(api_request_latency_seconds_bucket{endpoint=\"/predict\"}[5m])) by (le)) * 1000",
     "legendFormat": "p95"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "C",
     "expr": "histogram_quantile(0.99, sum(rate(api_request_latency_seconds_bucket{endpoint=\"/predict\"}[5m])) by (le)) * 1000",
     "legendFormat": "p99"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "ms",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 200
       },
       {
        "color": "red",
        "value": 300
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 6,
   "title": "Requisições por endpoint e status",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "A",
     "expr": "sum(rate(api_requests_total[5m])) by (endpoint, status)",
     "legendFormat": "{{endpoint}} {{status}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 7,
   "title": "Predições por faixa de risco",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 12,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "A",
     "expr": "sum(increase(api_predictions_total[5m])) by (risk_band)",
     "legendFormat": "{{risk_band}}"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   }
  },
  {
   "id": 8,
   "title": "Erros de predição por tipo",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 8,
    "y": 12,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "A",
     "expr": "sum(increase(api_prediction_errors_total[5m])) by (error)",
     "legendFormat": "{{error}}"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 9,
   "title": "Janela de observação e referência",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 16,
    "y": 12,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "A",
     "expr": "data_drift_window_rows",
     "legendFormat": "linhas na janela"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "B",
     "expr": "data_drift_reference_loaded",
     "legendFormat": "referência carregada"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "C",
     "expr": "data_drift_evaluated",
     "legendFormat": "drift avaliado"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "textMode": "value_and_name"
   }
  },
  {
   "id": 10,
   "title": "PSI por variável (10 maiores)",
   "type": "bargauge",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 20,
    "w": 12,
    "h": 10
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "A",
     "expr": "topk(10, data_drift_psi)",
     "legendFormat": "{{variable}}",
     "instant": true,
     "range": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 0.1
       },
       {
        "color": "red",
        "value": 0.25
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "orientation": "horizontal",
    "displayMode": "gradient"
   }
  },
  {
   "id": 11,
   "title": "KS por variável numérica",
   "type": "bargauge",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 20,
    "w": 12,
    "h": 10
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "A",
     "expr": "data_drift_ks_statistic",
     "legendFormat": "{{variable}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 0.1
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "orientation": "horizontal",
    "displayMode": "gradient"
   }
  },
  {
   "id": 12,
   "title": "Alerta de drift por variável (1 = alerta)",
   "type": "table",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 30,
    "w": 24,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "A",
     "expr": "data_drift_alert > 0",
     "legendFormat": "{{variable}}",
     "instant": true,
     "format": "table"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {}
  }
 ],
 "description": "Metricas RED da API de risco de hipertensao e drift (PSI/KS) contra a janela de treino. Provisionado por arquivo (docker/grafana/dashboards)."
}
